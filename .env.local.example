# Copie este arquivo pra .env.local (que já está no .gitignore) e
# preencha com as credenciais reais do seu App do Spotify.
#
# Como conseguir:
# 1. Acesse https://developer.spotify.com/dashboard e faça login com sua
#    conta Spotify (crie uma gratuita se não tiver).
# 2. Clique em "Create app".
# 3. Preencha nome/descrição (qualquer coisa, é só pra identificar o app
#    no seu painel). Em "Redirect URI" pode colocar http://localhost:3000
#    (não é usado pela busca, mas o formulário exige preencher).
# 4. Marque "Web API" nas APIs usadas.
# 5. Depois de criar, clique em "Settings" — lá estão o Client ID e,
#    clicando em "View client secret", o Client Secret.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
